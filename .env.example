# Environment variables
# Copy to `.env.local` for local development. Never commit real secrets.

# Fail production-style builds when MP4 / captions / poster are missing
# REQUIRE_VIDEO_ASSETS=1

# n8n webhook (server-only — never expose to the browser)
# Production webhook URL for the strategy call request workflow
n8n_connection_outreachpage=
# Optional shared HMAC secret used to sign X-Standout-Signature (timestamp.body)
N8N_WEBHOOK_SECRET=

# Analytics (Phase 5) — privacy-conscious; omit or set provider=none to disable
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# Plausible site domain (also accepted as NEXT_PUBLIC_ANALYTICS_ID)
# NEXT_PUBLIC_ANALYTICS_DOMAIN=standoutgroup.net

# Calendly embed (public event-type URL — not a secret; questions live in Calendly)
# NEXT_PUBLIC_CALENDLY_EVENT_URL=https://calendly.com/your-org/strategy-call
# Set to 1 to swap the CTA modal form for the Calendly widget (omit or 0 = form fallback)
# NEXT_PUBLIC_CALENDLY_ENABLED=1
# inline (default, widget inside our modal) or popup (Calendly overlay, skips our modal)
# NEXT_PUBLIC_CALENDLY_EMBED_MODE=inline
# Leave 0 for UK launch so Calendly’s GDPR banner stays visible
# NEXT_PUBLIC_CALENDLY_HIDE_GDPR_BANNER=0
